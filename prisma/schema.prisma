generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId      String          @id
  sheets      Sheet[]
  entry       Entry[]
}

model Sheet {
  id        String           @id @default(uuid())
  name      String           @unique
  userId    String
  user      User             @relation(fields: [userId], references: [userId], onDelete: Cascade)
  entry     Entry[]

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Entry {
  id              String    @id @default(uuid())
  incomeSource    String      
  date            DateTime
  investedAmount  Decimal   @db.Decimal(12, 2)
  returnAmount    Decimal   @db.Decimal(12, 2)
  fees            Decimal   @default(0) @db.Decimal(12, 2)

  sheetId         String
  sheet           Sheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([sheetId])
  @@index([userId])
}